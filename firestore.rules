rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          'admin@zensolve.com',
          'admin@zensolve.in',
          'superadmin@zensolve.com',
          'akmtechofficial@gmail.com'
        ] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isSuspended() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspended == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'suspended');
    }

    function isApprovedCompany() {
      return isAuthenticated() &&
        !isSuspended() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['company', 'employer'] &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved');
    }

    // ==========================================
    // 1. Users Collection
    // ==========================================
    match /users/{userId} {
      // Anyone authenticated can read their own profile; public can read approved company profiles; super-admin reads all
      allow read: if isOwner(userId) || isSuperAdmin() ||
        (resource.data.role in ['company', 'employer'] &&
         (resource.data.approved == true || resource.data.status == 'approved'));

      // Registration: candidates and companies create their initial profile (cannot grant themselves approved or admin status)
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        (request.resource.data.role in ['candidate', 'company', 'employer']) &&
        (!('approved' in request.resource.data) || request.resource.data.approved == false) &&
        (!('suspended' in request.resource.data) || request.resource.data.suspended == false);

      // Updates: user can update their own permitted fields but CANNOT self-promote to admin, self-approve, or unsuspended themselves
      allow update: if isSuperAdmin() || (
        isOwner(userId) &&
        !isSuspended() &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('approved' in request.resource.data) || request.resource.data.approved == resource.data.approved) &&
        (!('suspended' in request.resource.data) || request.resource.data.suspended == resource.data.suspended)
      );

      // Only super-admin can delete user profiles
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 2. Jobs Collection
    // ==========================================
    match /jobs/{jobId} {
      // Public can read active verified listings; company owner or super-admin can read drafts/closed
      allow read: if resource.data.status == 'Active' ||
        resource.data.status == null ||
        isSuperAdmin() ||
        (isAuthenticated() && resource.data.companyId == request.auth.uid);

      // Only approved companies or super-admin can publish jobs
      allow create: if isSuperAdmin() || (
        isApprovedCompany() &&
        request.resource.data.companyId == request.auth.uid
      );

      // Only job owner or super-admin can update listings (cannot forge companyId)
      allow update: if isSuperAdmin() || (
        isApprovedCompany() &&
        resource.data.companyId == request.auth.uid &&
        (!('companyId' in request.resource.data) || request.resource.data.companyId == resource.data.companyId)
      );

      // Only job owner or super-admin can delete listings
      allow delete: if isSuperAdmin() || (
        isAuthenticated() &&
        !isSuspended() &&
        resource.data.companyId == request.auth.uid
      );
    }

    // ==========================================
    // 3. Job Applications Collection
    // ==========================================
    match /jobApplications/{applicationId} {
      // Strictly private: Candidate owner, Target company employer, or Super-Admin
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.companyId == request.auth.uid
        )
      );

      // Candidates can submit applications (must bind userId and initial status 'Applied')
      allow create: if isAuthenticated() &&
        !isSuspended() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'Applied';

      // Updates:
      // 1. Super-admin full access
      // 2. Candidate withdrawing their active application (cannot alter target company or job)
      // 3. Target company recruiter updating status, interview, or internal notes
      allow update: if isSuperAdmin() || (
        isAuthenticated() && !isSuspended() && (
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.status == 'Withdrawn' &&
            resource.data.status != 'Withdrawn' &&
            resource.data.status != 'Selected' &&
            resource.data.status != 'Rejected' &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.jobId == resource.data.jobId
          ) ||
          (
            resource.data.companyId == request.auth.uid &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.jobId == resource.data.jobId
          )
        )
      );

      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 4. Testimonials Collection
    // ==========================================
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;
      allow update, delete: if isSuperAdmin();
    }

    // ==========================================
    // 5. Audit Logs (Super-Admin only)
    // ==========================================
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }

    // ==========================================
    // 6. Reports & Platform Settings
    // ==========================================
    match /reports/{reportId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    match /platformSettings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 7. Data Deletion Requests (DPDP Act)
    // ==========================================
    match /deletionRequests/{requestId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || request.resource.data.userId == null);
      allow update, delete: if isSuperAdmin();
    }

    // ==========================================
    // 8. Grievance Redressal Tickets (IT Rules)
    // ==========================================
    match /grievanceRequests/{requestId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // ==========================================
    // 9. Job Fraud & Scam Reports
    // ==========================================
    match /fraudReports/{reportId} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // ==========================================
    // 10. Cookie & Consent Audit Logs
    // ==========================================
    match /consentLogs/{logId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }
  }
}
