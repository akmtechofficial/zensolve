rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Server-controlled custom claims verified administrator
    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.get('admin', false) == true && request.auth.token.get('email_verified', false) == true) ||
        (request.auth.token.get('email', '') == 'admin@zensolve.in' && request.auth.token.get('email_verified', false) == true)
      );
    }

    function isAdmin() {
      return isSuperAdmin();
    }

    // Candidate Resumes: Strictly Private
    // Accessible only to the candidate owner and trusted super-admins.
    // Employers access verified resumes via authenticated backend broker.
    // S17: Removed 'application/octet-stream' to prevent MIME bypass.
    match /resumes/{userId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ];
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // Company Logos: PNG, JPEG, WEBP only (max 500 KB)
    // S17: Removed arbitrary 'image/.*' and 'image/svg+xml' to mitigate SVG stored XSS.
    match /company_logos/{companyId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == companyId || isSuperAdmin()) &&
        request.resource.size <= 500 * 1024 &&
        request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp'];
      allow delete: if isAuthenticated() && (request.auth.uid == companyId || isSuperAdmin());
    }

    match /companies/{companyId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == companyId || isSuperAdmin()) &&
        request.resource.size <= 500 * 1024 &&
        request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp'];
      allow delete: if isAuthenticated() && (request.auth.uid == companyId || isSuperAdmin());
    }

    // Candidate & User Avatars: PNG, JPEG, WEBP only (max 2 MB)
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp'];
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }
  }
}
